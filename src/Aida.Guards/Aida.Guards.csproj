    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="StyleCop.Analyzers">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Vocabulary\forbidden-in-code.txt" LogicalName="Aida.Guards.Vocabulary.forbidden-in-code.txt" />
    <EmbeddedResource Include="Vocabulary\forbidden-everywhere.txt" LogicalName="Aida.Guards.Vocabulary.forbidden-everywhere.txt" />
  </ItemGroup>
</Project>
