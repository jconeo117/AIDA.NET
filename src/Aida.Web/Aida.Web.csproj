<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Aida.Engine\Aida.Engine.csproj" />
    <ProjectReference Include="..\Aida.Platform\Aida.Platform.csproj" />
    <ProjectReference Include="..\Aida.Capture\Aida.Capture.csproj" />
    <ProjectReference Include="..\Aida.Cognition\Aida.Cognition.csproj" />
    <ProjectReference Include="..\Aida.Channel\Aida.Channel.csproj" />
    <ProjectReference Include="..\Aida.Arms.Health\Aida.Arms.Health.csproj" />
    <ProjectReference Include="..\Aida.Arms.Agenda\Aida.Arms.Agenda.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Razor genera una clase pública por componente, sin comentario XML posible. Las clases .cs
         de este proyecto se documentan igual; la unidad N001 decide si un analizador lo comprueba
         solo sobre ellas (ADR 0016). -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
