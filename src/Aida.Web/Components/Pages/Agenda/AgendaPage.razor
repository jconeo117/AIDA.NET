@page "/agenda"
@using System.Globalization
@using Aida.Arms.Agenda.Assistant
@using Aida.Arms.Agenda.Desk
@using Aida.Arms.Agenda.Storage
@using Aida.Arms.Agenda.Wording
@using Aida.Cognition.Interpretation
@using Aida.Engine.Actions
@inject AgendaDesk Desk
@inject AgendaWording Text
@inject AssistantInterpreter Interpreter
@inject AgendaAssistant Proposer
@inject TimeProvider Time
@inject NavigationManager Navigation

<PageTitle>@Text["title"]</PageTitle>

<div class="agenda-head">
    <h1>@Text["title"]</h1>
    <nav class="day-nav">
        <a href="@AgendaLinks.Day(_day.AddDays(-1))">‹</a>
        <a href="@AgendaLinks.Day(_today)">@Text["today"]</a>
        <a href="@AgendaLinks.Day(_day.AddDays(1))">›</a>
    </nav>
    <span>@_day.ToString("D", CultureInfo.CurrentCulture)</span>
    <EditForm Model="Search" FormName="agenda-search" method="post" OnSubmit="SubmitSearch">
        <AntiforgeryToken />
        <input name="Search.Query" type="search" placeholder="@Text["search_placeholder"]" value="@Search.Query" />
    </EditForm>
    <EditForm Model="Assistant" FormName="agenda-assistant" method="post" OnSubmit="SubmitAssistant">
        <AntiforgeryToken />
        @if (_canManage)
        {
            <input name="Assistant.Text" type="text" placeholder="@Text["assistant_placeholder"]" />
            <button type="submit">@Text["assistant_button"]</button>
        }
    </EditForm>
</div>
<WeekStrip View="@_view" />

<EditForm Model="Command" FormName="agenda-action" method="post" OnSubmit="Submit">
    <AntiforgeryToken />
    @if (_message is not null)
    {
        <p role="status">@_message</p>
    }
    @if (_conflicts.Count > 0)
    {
        <ConflictList Conflicts="@_conflicts" />
    }
    <div class="agenda">
        <AgendaGrid View="@_view" />
        <aside class="side">
            <AgendaSide View="@_view" Day="@_day" Panel="@_panel" CanManage="@_canManage" CanBlock="@_canBlock"
                ServiceId="@_serviceId" FirstService="@_firstService" Appointment="@_appointment" Block="@_block"
                Card="@_card" Prefill="@_prefill" Found="@_found" Choices="@_choices" ChoicesForCard="@_choicesForCard"
                TimeNotice="@_timeNotice" />
        </aside>
    </div>
</EditForm>

@code {
    private DateOnly _today;
    private DateOnly _day;
    private DayView _view = null!;
    private bool _canManage;
    private bool _canBlock;
    private string? _message;
    private string? _panel;
    private string? _serviceId;
    private string? _firstService;
    private AppointmentView? _appointment;
    private BlockView? _block;
    private ClientCard? _card;
    private Client? _prefill;
    private IReadOnlyList<Client>? _found;
    private IReadOnlyList<Client>? _choices;
    private bool _choicesForCard;
    private string? _timeNotice;
    private IReadOnlyList<AppointmentView> _conflicts = [];

    [CascadingParameter]
    private HttpContext Http { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "dia")]
    public string? Dia { get; set; }

    [SupplyParameterFromQuery(Name = "cita")]
    public string? Cita { get; set; }

    [SupplyParameterFromQuery(Name = "nueva")]
    public string? Nueva { get; set; }

    [SupplyParameterFromQuery(Name = "mover")]
    public string? Mover { get; set; }

    [SupplyParameterFromQuery(Name = "cancelar")]
    public string? Cancelar { get; set; }

    [SupplyParameterFromQuery(Name = "editar")]
    public string? Editar { get; set; }

    [SupplyParameterFromQuery(Name = "bloquear")]
    public string? Bloquear { get; set; }

    [SupplyParameterFromQuery(Name = "bloqueo")]
    public string? Bloqueo { get; set; }

    [SupplyParameterFromQuery(Name = "ficha")]
    public string? Ficha { get; set; }

    [SupplyParameterFromQuery(Name = "contacto")]
    public string? Contacto { get; set; }

    [SupplyParameterFromForm(FormName = "agenda-action", Name = "Command")]
    private AgendaCommandForm? PostedCommand { get; set; }

    private AgendaCommandForm Command => PostedCommand ??= new();

    [SupplyParameterFromForm(FormName = "agenda-search", Name = "Search")]
    private AgendaSearchForm? PostedSearch { get; set; }

    private AgendaSearchForm Search => PostedSearch ??= new();

    [SupplyParameterFromForm(FormName = "agenda-assistant", Name = "Assistant")]
    private AgendaAssistantForm? PostedAssistant { get; set; }

    private AgendaAssistantForm Assistant => PostedAssistant ??= new();

    protected override void OnInitialized()
    {
        _today = DateOnly.FromDateTime(Time.GetLocalNow().DateTime);
        _day = DateOnly.TryParseExact(Dia, AgendaLinks.DayFormat, CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed) ? parsed : _today;
        var user = SessionGate.CurrentUser(Http);
        _canManage = user is not null && Desk.CanManage(user);
        _canBlock = user is not null && Desk.CanBlock(user);
        _view = Desk.Day(_day);
        _firstService = _view.Setup.Services.FirstOrDefault()?.Id;
        _serviceId = Nueva is not null && _view.Setup.Service(Nueva) is not null ? Nueva : _firstService;
        _panel = PanelName();
        _appointment = FindAppointment(Cancelar ?? Mover ?? Editar ?? Cita);
        _block = FindBlock(Bloqueo);
        _card = FindCard(Ficha ?? Contacto);
        _prefill = Nueva is not null && Contacto is not null ? _card?.Client : null;
    }

    /// <summary>El panel que pide la URL, en el orden de la pantalla.</summary>
    /// <remarks>El contacto solo abre su editor si no hay una nueva cita: con <c>nueva</c> su nombre rellena el formulario.
    /// La búsqueda no está aquí: la pone su manejador, nunca la URL.</remarks>
    private string? PanelName() =>
        Cancelar is not null ? "cancelar"
        : Mover is not null ? "mover"
        : Editar is not null ? "editar"
        : Cita is not null ? "cita"
        : Contacto is not null && Nueva is null ? "contacto"
        : Ficha is not null ? "ficha"
        : Bloqueo is not null ? "bloqueo"
        : Bloquear is not null ? "bloquear"
        : Nueva is not null ? "nueva"
        : null;

    private AppointmentView? FindAppointment(string? target) =>
        target is not null && long.TryParse(target, NumberStyles.Integer, CultureInfo.InvariantCulture, out var id)
            ? _view.Appointments.FirstOrDefault(appointment => appointment.Appointment.Id == id)
            : null;

    private BlockView? FindBlock(string? target) =>
        target is not null && long.TryParse(target, NumberStyles.Integer, CultureInfo.InvariantCulture, out var id)
            ? _view.Blocks.FirstOrDefault(block => block.Block.Id == id)
            : null;

    private ClientCard? FindCard(string? target) =>
        target is not null && long.TryParse(target, NumberStyles.Integer, CultureInfo.InvariantCulture, out var id)
            ? Desk.Card(id)
            : null;

    private void Submit()
    {
        var user = SessionGate.CurrentUser(Http);
        if (user is null)
        {
            return;
        }

        var action = Command.Action ?? string.Empty;
        var arguments = AgendaArguments.From(Command, _view.Now.Offset);
        var result = Desk.Submit(user, AidaWebApp.Workstation(Http), action, arguments);
        if (result.Status == ToolStatus.Done)
        {
            var day = AgendaArguments.DayOf(arguments) ?? _day;
            Navigation.NavigateTo(AgendaLinks.AfterDone(day, action, result.Data));
            return;
        }

        if (result.Reason == "forbidden")
        {
            Http.Response.StatusCode = StatusCodes.Status403Forbidden;
            _message = Text["reason_forbidden"];
            return;
        }

        _message = Text.Reason(result.Reason);
        _conflicts = Desk.Conflicts(result);
    }

    /// <summary>Busca y muestra el resultado en el mismo panel, sin redirigir: la consulta no llega a la URL.</summary>
    private void SubmitSearch()
    {
        if (SessionGate.CurrentUser(Http) is null)
        {
            return;
        }

        _found = Desk.Search(Search.Query ?? string.Empty);
        _panel = "buscar";
    }

    /// <summary>Entiende la frase y propone un panel, en la misma petición y sin redirigir. No cambia nada: el cambio lo hace el
    /// operador con el botón de siempre.</summary>
    private void SubmitAssistant()
    {
        if (SessionGate.CurrentUser(Http) is not { } user)
        {
            return;
        }

        if (!Desk.CanManage(user))
        {
            Http.Response.StatusCode = StatusCodes.Status403Forbidden;
            return;
        }

        var proposal = Proposer.Propose(Interpreter.Interpret(Assistant.Text ?? string.Empty, _today));
        var outcome = AgendaAssistantView.Apply(proposal, Desk);
        if (outcome.Panel is not null)
        {
            _panel = outcome.Panel;
            _serviceId = outcome.ServiceId ?? _serviceId;
            _prefill = outcome.Prefill;
            _card = outcome.Card;
            _choices = outcome.Choices;
            _choicesForCard = outcome.ChoicesForCard;
        }

        _message = outcome.MessageKey is null ? null : Text[outcome.MessageKey];
        _timeNotice = outcome.TimeNoticeKey is null ? null : Text[outcome.TimeNoticeKey];
    }
}
