@using System.Globalization
@using Aida.Arms.Agenda.Desk
@using Aida.Arms.Agenda.Wording
@using Aida.Platform.People
@inject AgendaWording Text
@inject PersonCatalog People

<div class="panel-card">
    <h3>@Text["card_edit"]</h3>
    <input type="hidden" name="Command.Client" value="@Card.Client.Id.ToString(CultureInfo.InvariantCulture)" />
    <label>@Text["field_name"] <input name="Command.Name" value="@Card.Client.Name" /></label>
    <label>@Text["field_phone"] <input name="Command.Phone" value="@Card.Client.Phone" /></label>
    <label>@Text["field_document_type"]
        <select name="Command.DocumentType">
            <option value="" selected="@(Card.Details.DocumentType is null)">—</option>
            @foreach (var (id, label) in People.DocumentTypes)
            {
                <option value="@id" selected="@(id == Card.Details.DocumentType)">@label</option>
            }
        </select>
    </label>
    <label>@Text["field_document_number"] <input name="Command.DocumentNumber" value="@Card.Details.DocumentNumber" /></label>
    <label>@Text["field_birth_date"] <input name="Command.BirthDate" type="date" value="@(Card.Details.BirthDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))" /></label>
    <label>@Text["field_sex"]
        <select name="Command.Sex">
            <option value="" selected="@(Card.Details.Sex is null)">—</option>
            @foreach (var (id, label) in People.Sexes)
            {
                <option value="@id" selected="@(id == Card.Details.Sex)">@label</option>
            }
        </select>
    </label>
    <div class="side-actions">
        <button type="submit" name="Command.Action" value="editar_contacto">@Text["save_button"]</button>
        <a href="@AgendaLinks.Panel(Day, "ficha", Card.Client.Id.ToString(CultureInfo.InvariantCulture))">@Text["close_button"]</a>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public ClientCard Card { get; set; } = null!;

    [Parameter, EditorRequired]
    public DateOnly Day { get; set; }
}
