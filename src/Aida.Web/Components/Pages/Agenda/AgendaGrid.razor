@using System.Globalization
@using Aida.Arms.Agenda.Desk
@using Aida.Arms.Agenda.Storage
@using Aida.Arms.Agenda.Wording
@inject AgendaWording Text

<table class="grid">
    <thead>
        <tr>
            <th></th>
            @foreach (var resource in View.Setup.Resources)
            {
                <th>@resource.Label<small>@resource.Place</small></th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var time in _times)
        {
            <tr>
                <th>@time.ToString("HH:mm", CultureInfo.InvariantCulture)</th>
                @foreach (var resource in View.Setup.Resources)
                {
                    <td>
                        @foreach (var item in Cell(resource.Id, time))
                        {
                            <a class="appt @StateClass(item.Appointment.State)" href="@AgendaLinks.Panel(View.Day, "cita", item.Appointment.Id.ToString(CultureInfo.InvariantCulture))">
                                <b>@item.ClientName</b>
                                <span>@item.ServiceLabel</span>
                            </a>
                        }
                        @if (BlockCell(resource.Id, time) is { } blocked)
                        {
                            <a class="blocked" href="@AgendaLinks.Panel(View.Day, "bloqueo", blocked.Block.Id.ToString(CultureInfo.InvariantCulture))">
                                @if (IsFirstBlockCell(resource.Id, time, blocked))
                                {
                                    <span>@BlockLabel(blocked)</span>
                                }
                            </a>
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

@code {
    private IReadOnlyList<TimeOnly> _times = [];

    [Parameter, EditorRequired]
    public DayView View { get; set; } = null!;

    protected override void OnParametersSet()
    {
        var starts = new SortedSet<TimeOnly>();
        foreach (var resource in View.Setup.Resources)
        {
            foreach (var range in resource.HoursOn(View.Day.DayOfWeek))
            {
                for (var minutes = range.Start.Hour * 60 + range.Start.Minute; minutes < range.End.Hour * 60 + range.End.Minute; minutes += View.Setup.SlotMinutes)
                {
                    starts.Add(new TimeOnly(minutes / 60, minutes % 60));
                }
            }
        }

        foreach (var appointment in View.Appointments)
        {
            starts.Add(TimeOnly.FromDateTime(appointment.Appointment.Start.DateTime));
        }

        _times = [.. starts];
    }

    private IEnumerable<AppointmentView> Cell(string resource, TimeOnly time) =>
        View.Appointments.Where(item => item.Appointment.Resource == resource
            && TimeOnly.FromDateTime(item.Appointment.Start.DateTime) == time);

    /// <summary>El bloqueo que cubre la celda, si la celda no tiene cita.</summary>
    /// <remarks>Una cita se pinta encima de un bloqueo: si las dos coinciden, la cita es la que importa en la rejilla.</remarks>
    private BlockView? BlockCell(string resource, TimeOnly time)
    {
        if (Cell(resource, time).Any())
        {
            return null;
        }

        var start = CellStart(time);
        return View.BlockAt(resource, start, start.AddMinutes(View.Setup.SlotMinutes));
    }

    /// <summary>Si esta es la primera celda que cubre el bloqueo en esa columna: el texto va solo ahí.</summary>
    /// <remarks>Sin esto, un bloqueo de cuatro huecos repetiría su motivo en cada fila, y la columna se leería como cuatro cosas.</remarks>
    private bool IsFirstBlockCell(string resource, TimeOnly time, BlockView blocked) =>
        _times.FirstOrDefault(candidate => BlockCell(resource, candidate)?.Block.Id == blocked.Block.Id) == time;

    private string BlockLabel(BlockView blocked) =>
        blocked.Block.Reason.Length > 0 ? blocked.Block.Reason : Text["blocked_label"];

    private DateTimeOffset CellStart(TimeOnly time) => new(View.Day.ToDateTime(time), View.Now.Offset);

    private static string StateClass(AppointmentState state) => state switch
    {
        AppointmentState.Booked => "booked",
        AppointmentState.Cancelled => "cancelled",
        AppointmentState.Attended => "attended",
        _ => "no-show",
    };
}
