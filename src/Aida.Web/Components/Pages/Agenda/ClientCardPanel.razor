@using System.Globalization
@using Aida.Arms.Agenda.Desk
@using Aida.Arms.Agenda.Setup
@using Aida.Arms.Agenda.Wording
@using Aida.Arms.Health.Desk
@using Aida.Arms.Health.Setup
@using Aida.Platform.People
@inject AgendaWording Text
@inject PersonCatalog People
@inject HealthDesk Health
@inject EncounterTemplate HealthTemplate

<div class="panel-card">
    <h3>@Card.Client.Name</h3>
    @if (CanReadHistory)
    {
        <p><a href="/historia/@Card.Client.Id">@HealthTemplate["card_link"]</a></p>
    }
    <p>@Text["field_phone"]: @Card.Client.Phone</p>
    <dl class="kv">
        <dt>@Text["card_upcoming"]</dt>
        <dd>@Card.Upcoming</dd>
        <dt>@Text["card_attended"]</dt>
        <dd>@Card.Attended</dd>
        <dt>@Text["card_no_show"]</dt>
        <dd>@Card.NoShow</dd>
        <dt>@Text["field_document_type"]</dt>
        <dd>@DocumentTypeLabel</dd>
        <dt>@Text["field_document_number"]</dt>
        <dd>@(Card.Details.DocumentNumber ?? "—")</dd>
        <dt>@Text["field_birth_date"]</dt>
        <dd>@(Card.Details.BirthDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "—")</dd>
        <dt>@Text["field_sex"]</dt>
        <dd>@SexLabel</dd>
    </dl>
    <h4>@Text["card_appointments"]</h4>
    <ul>
        @foreach (var view in Card.Appointments)
        {
            <li>
                <a href="@AgendaLinks.Panel(DateOnly.FromDateTime(view.Appointment.Start.DateTime), "cita", view.Appointment.Id.ToString(CultureInfo.InvariantCulture))">
                    @view.Appointment.Start.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) · @view.ServiceLabel · @(Setup.Resource(view.Appointment.Resource)?.Label ?? view.Appointment.Resource) · @Text[AgendaStateKeys.Of(view.Appointment.State)]
                </a>
            </li>
        }
    </ul>
    @if (CanManage)
    {
        <div class="side-actions">
            <a href="@AgendaLinks.Panel(Day, "contacto", Card.Client.Id.ToString(CultureInfo.InvariantCulture))">@Text["card_edit"]</a>
            @if (FirstService is not null)
            {
                <a href="@AgendaLinks.NewFor(Day, FirstService, Card.Client.Id)">@Text["new_button"]</a>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public ClientCard Card { get; set; } = null!;

    /// <summary>El nombre del tipo de documento, de <c>people.yaml</c>; si no está en el pack, su código.</summary>
    private string DocumentTypeLabel => Card.Details.DocumentType is { } id
        ? People.DocumentTypes.Where(entry => entry.Id == id).Select(entry => entry.Label).FirstOrDefault() ?? id
        : "—";

    private string SexLabel => Card.Details.Sex is { } id
        ? People.Sexes.Where(entry => entry.Id == id).Select(entry => entry.Label).FirstOrDefault() ?? id
        : "—";

    [Parameter, EditorRequired]
    public AgendaSetup Setup { get; set; } = null!;

    [Parameter]
    public bool CanManage { get; set; }

    [Parameter, EditorRequired]
    public DateOnly Day { get; set; }

    [Parameter]
    public string? FirstService { get; set; }

    [CascadingParameter]
    private HttpContext Http { get; set; } = default!;

    /// <summary>Si quien mira puede abrir la historia: el enlace solo aparece entonces.</summary>
    /// <remarks>La ficha es de la agenda y no decide permisos de salud: pregunta al mostrador de la historia, que es quien los conoce.</remarks>
    private bool CanReadHistory => SessionGate.CurrentUser(Http) is { } user && Health.CanRead(user);
}
